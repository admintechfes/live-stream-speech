# Copy to .env and fill in. Never commit .env.

# Which speech engine the capture pages use: azure or soniox. A single hall can
# be flipped without touching this, with ?provider=<other> on its capture URL.
# The server refuses to start if the selected provider's credentials are missing.
SPEECH_PROVIDER=azure

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v5

# One entry per hall with its own audio source.
HALLS=hall-1,hall-2,hall-3,hall-4

# Continuous language ID candidates, and the language shown on every screen.
SOURCE_LANGS=ta-IN,hi-IN,en-IN
TARGET_LANG=en

# Speaker names, org names, event-specific terms. Improves recognition of the
# words most likely to be wrong and most embarrassing to get wrong.
PHRASE_LIST=

# Shared secret for /capture.html and /operator.html. Screens stay open.
# Set this before the event.
CONTROL_KEY=

# Optional review delay in ms before finals reach the screens (e.g. 1500).
# Partials are suppressed when this is > 0.
CAPTION_DELAY_MS=0

PORT=8080
REPLAY_LINES=6
